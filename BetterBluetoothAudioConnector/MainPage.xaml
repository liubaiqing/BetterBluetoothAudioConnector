<Window
    x:Class="BetterBluetoothAudioConnector.MainPage"
    Title="Better Bluetooth Audio Connector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:BetterBluetoothAudioConnector.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="MainGrid"
          Loaded="MainGrid_Loaded"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="10,8,10,4">
            <StackPanel HorizontalAlignment="Center" Margin="34,0">
                <TextBlock Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.WatcherStatusText, Mode=OneWay}"
                           FontSize="11"
                           Opacity="0.65"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Height="30"
                    Padding="10,4"
                    Click="OpenLogsButton_Click"
                    Content="Open Logs"
                    ToolTipService.ToolTip="Open diagnostic log folder" />
        </Grid>

        <ListView Grid.Row="1"
                  Margin="10,4"
                  ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                  IsEnabled="{x:Bind ViewModel.CanSelectDevice, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:DeviceItemViewModel">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <SymbolIcon Symbol="Audio" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                       FontSize="11"
                                       Opacity="0.65" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Margin="10,6,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="Connect"
                    Click="ConnectButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                    MinWidth="96"
                    Padding="8,6"
                    Margin="0,0,3,0"
                    HorizontalAlignment="Stretch" />
            <Button Grid.Column="1"
                    Content="{x:Bind ViewModel.DisconnectButtonText, Mode=OneWay}"
                    Click="DisconnectButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanDisconnect, Mode=OneWay}"
                    MinWidth="96"
                    Padding="8,6"
                    Margin="3,0"
                    HorizontalAlignment="Stretch" />
            <Button Grid.Column="2"
                    Content="Reconnect"
                    Click="ReconnectButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanReconnect, Mode=OneWay}"
                    MinWidth="96"
                    Padding="8,6"
                    Margin="3,0,0,0"
                    HorizontalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
